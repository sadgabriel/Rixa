{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "format-competition-analyze.json",
  "title": "CompetitionAnalyzeBatchOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "analysis_results"],
  "properties": {
    "phase": { "type": "string", "const": "competition_analyze" },
    "analysis_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "description": "One analysis result per match, in the same order as input.",
      "items": { "$ref": "#/$defs/matchAnalysis" }
    }
  },
  "$defs": {
    "tag": {
      "type": "string",
      "enum": [
        "coherence",
        "evidence_and_reasoning",
        "situational_leverage",
        "anticipation_and_counterplay",
        "creativity",

        "deception",
        "pressure",
        "escalation",
        "high_variance",

        "nonresponsive",
        "unsupported_or_logical_gap",
        "self_contradiction_or_overreach"
      ]
    },
    "sideAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tags"],
      "properties": {
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/tag" },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Interpretive tags for this side. Tags are used for scoring; do not repeat."
        }
      }
    },
    "matchAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match_id", "attacker", "defender", "targeted_resources", "protected_resources"],
      "properties": {
        "match_id": {
          "type": "string",
          "pattern": "^m_[0-9]{2}$",
          "description": "Match identifier from input (e.g., m_01)."
        },
        "attacker": { "$ref": "#/$defs/sideAnalysis" },
        "defender": { "$ref": "#/$defs/sideAnalysis" },
        "targeted_resources": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true,
          "description": "Defender resources intentionally targeted by attacker. Use only names provided in input for this match."
        },
        "protected_resources": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true,
          "description": "Defender resources actively protected by defender. Use only names provided in input for this match."
        }
      }
    }
  }
}
