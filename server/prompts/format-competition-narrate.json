{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "format-competition-narrate.json",
  "title": "CompetitionNarrateBatchOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "results", "context_log"],
  "properties": {
    "phase": { "type": "string", "const": "competition_narrate" },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/matchNarration" },
      "description": "One narration per match, in the same order as input."
    },
    "context_log": {
      "type": "string",
      "minLength": 60,
      "maxLength": 200,
      "description": "Batch-level concise log to accumulate and pass into future prompts."
    }
  },
  "$defs": {
    "matchNarration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match_id", "display_narrative"],
      "properties": {
        "match_id": {
          "type": "string",
          "pattern": "^m_[0-9]{2}$",
          "description": "Match identifier from input (e.g., m_01)."
        },
        "display_narrative": {
          "type": "string",
          "minLength": 80,
          "maxLength": 200,
          "description": "Player-facing narrative reflecting the resolved outcome and given resource changes."
        }
      }
    }
  }
}