{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "format-context.json",
  "title": "ContextSetupOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "context", "factions"],
  "properties": {
    "phase": {
      "type": "string",
      "const": "context_setup"
    },
    "context": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary"],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 80,
            "maxLength": 420,
            "description": "Finalized competitive context (world/background/stage) description."
          }
        }
      },
    "factions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "description": "Must include exactly the factions provided in input. Preserve ids and order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "summary", "resources"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^fac_[0-9]{2}$",
            "description": "System identifier. Must match input exactly (e.g., fac_01)."
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "description": "Display name provided by the player. Must match input exactly."
          },
          "summary": {
            "type": "string",
            "minLength": 60,
            "maxLength": 240,
            "description": "Finalized faction description. Should naturally include the faction name."
          },
          "resources": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "description"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 100,
                  "description": "Resource name (may be abstract or surreal)."
                },
                "description": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 120,
                  "description": "What this resource represents and why it matters as abstract capacity."
                }
              }
            }
          }
        }
      }
    }
  }
}
